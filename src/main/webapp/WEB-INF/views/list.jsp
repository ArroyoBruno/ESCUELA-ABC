<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${title} | ESCUELA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/">Sistema ESCUELA</a><a class="btn btn-outline-light btn-sm" href="${pageContext.request.contextPath}/">Inicio</a></div></nav><main class="container py-4"><div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><h1 class="h2">${title}</h1><p class="text-secondary mb-0">Altas, bajas, cambios y consultas.</p></div><a class="btn btn-success" href="${pageContext.request.contextPath}/${entity}?action=form">+ Nuevo registro</a></div>
<c:if test="${not empty sessionScope.flash}"><div class="alert alert-success alert-dismissible">${sessionScope.flash}<button class="btn-close" data-bs-dismiss="alert"></button></div><c:remove var="flash" scope="session"/></c:if><c:if test="${not empty sessionScope.error}"><div class="alert alert-warning alert-dismissible">${sessionScope.error}<button class="btn-close" data-bs-dismiss="alert"></button></div><c:remove var="error" scope="session"/></c:if>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead class="table-dark"><tr>
<c:choose><c:when test="${entity eq 'alumnos'}"><th>ID</th><th>Nombre</th><th>Edad</th><th>Promedio</th></c:when><c:when test="${entity eq 'profesores'}"><th>ID</th><th>Nombre</th><th>Especialidad</th></c:when><c:when test="${entity eq 'materias'}"><th>ID</th><th>Nombre</th><th>Créditos</th></c:when><c:when test="${entity eq 'profesor-materia'}"><th>ID profesor</th><th>Profesor</th><th>ID materia</th><th>Materia</th></c:when><c:otherwise><th>ID</th><th>ID alumno</th><th>Alumno</th><th>ID materia</th><th>Materia</th><th>Calificación</th></c:otherwise></c:choose><th>Acciones</th></tr></thead><tbody>
<c:forEach var="r" items="${rows}"><tr><c:choose><c:when test="${entity eq 'alumnos'}"><td>${r.ID}</td><td>${r.NOMBRE}</td><td>${r.EDAD}</td><td>${r.PROMEDIO}</td></c:when><c:when test="${entity eq 'profesores'}"><td>${r.ID}</td><td>${r.NOMBRE}</td><td>${r.ESPECIALIDAD}</td></c:when><c:when test="${entity eq 'materias'}"><td>${r.ID}</td><td>${r.NOMBRE}</td><td>${r.CREDITOS}</td></c:when><c:when test="${entity eq 'profesor-materia'}"><td>${r.PROFESOR_ID}</td><td>${r.PROFESOR}</td><td>${r.MATERIA_ID}</td><td>${r.MATERIA}</td></c:when><c:otherwise><td>${r.ID}</td><td>${r.ALUMNO_ID}</td><td>${r.ALUMNO}</td><td>${r.MATERIA_ID}</td><td>${r.MATERIA}</td><td>${r.CALIFICACION}</td></c:otherwise></c:choose><td class="text-nowrap"><c:choose><c:when test="${entity eq 'profesor-materia'}"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/${entity}?action=form&id=${r.PROFESOR_ID},${r.MATERIA_ID}">Editar</a><c:set var="rid" value="${r.PROFESOR_ID},${r.MATERIA_ID}"/></c:when><c:otherwise><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/${entity}?action=form&id=${r.ID}">Editar</a><c:set var="rid" value="${r.ID}"/></c:otherwise></c:choose><form method="post" action="${pageContext.request.contextPath}/${entity}" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${rid}"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></td></tr></c:forEach>
<c:if test="${empty rows}"><tr><td colspan="7" class="text-center text-secondary py-4">No hay registros para mostrar.</td></tr></c:if></tbody></table></div></div><p class="text-secondary small mt-3">Las bajas respetan las relaciones de la base de datos. Si un registro está relacionado, elimina primero su relación.</p></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
